{
  "name": "hanwen-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --ignore-path ../.prettierignore --write \"src/**/*.{vue,ts,css,json}\" \"*.{ts,mjs,json}\" \"../tests/**/*.{js,mjs}\"",
    "format:check": "prettier --ignore-path ../.prettierignore --check \"src/**/*.{vue,ts,css,json}\" \"*.{ts,mjs,json}\" \"../tests/**/*.{js,mjs}\""
  },
  "dependencies": {
    "element-plus": "2.14.7",
    "vue": "3.5.43",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.12"
  }
}
