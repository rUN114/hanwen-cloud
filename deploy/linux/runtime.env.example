# Copy to /etc/hanwen/runtime.env; replace every REPLACE_ME value; chmod 640 root:hanwen.
HW_DB_HOST=127.0.0.1
HW_DB_PORT=3307
HW_USER_DB_USER=hw_user_app
HW_COURSE_DB_USER=hw_course_app
HW_LEARNING_DB_USER=hw_learning_app
HW_ASSIGNMENT_DB_USER=hw_assignment_app
HW_USER_DB_PASSWORD=REPLACE_ME_USER_DB_SECRET
HW_COURSE_DB_PASSWORD=REPLACE_ME_COURSE_DB_SECRET
HW_LEARNING_DB_PASSWORD=REPLACE_ME_LEARNING_DB_SECRET
HW_ASSIGNMENT_DB_PASSWORD=REPLACE_ME_ASSIGNMENT_DB_SECRET
HW_ADMIN_PASSWORD=REPLACE_ME_INITIAL_ADMIN_SECRET
HW_SERVICE_KEY=REPLACE_ME_INTERNAL_SECRET
HW_PUBLIC_KEY_FILE=/etc/hanwen/keys/public.pem
HW_PRIVATE_KEY_FILE=/etc/hanwen/keys/private.pem
HW_STORAGE_DIR=/var/lib/hanwen/uploads
HW_FRONTEND_ORIGIN=https://hanwen.example.com
HW_COOKIE_SECURE=true
HW_EUREKA_URL=http://127.0.0.1:8761/eureka/
